/**
 * ================================================================================
 * Modern Dark Theme - Face Recognition System
 * ================================================================================
 * Version: 2.3
 * ================================================================================
 */

/* ============================================================================
   全局样式 - 暗色主题
   ============================================================================ */

* {
    outline: none;
    font-size: 14px;
}

QWidget {
    font-family: "Microsoft YaHei UI", "Segoe UI", "PingFang SC", sans-serif;
    font-size: 14px;
    color: #e8e8e8;
    background-color: transparent;
}

QMainWindow {
    background-color: #1a1a1a;
}

/* ============================================================================
   卡片组件 - 暗色
   ============================================================================ */

#CardWidget {
    background-color: #262626;
    border-radius: 12px;
    border: 1px solid #3a3a3a;
}

#CardWidget[cardVariant="dark"] {
    background-color: #1f1f1f;
    border: none;
}

#CardWidget[cardVariant="ghost"] {
    background-color: transparent;
    border: 1px dashed #4a4a4a;
}

#CardTitle {
    font-size: 16px;
    font-weight: 600;
    color: #e8e8e8;
    background: transparent;
}

#CardSubtitle {
    font-size: 13px;
    color: #8c8c8c;
    background: transparent;
}

#CardHeader, #CardBody, #CardFooter {
    background: transparent;
}

/* ============================================================================
   侧边栏 - 暗色
   ============================================================================ */

#SideMenu {
    background-color: #141414;
    border-right: 1px solid #262626;
}

#LogoContainer {
    background-color: #1a1a1a;
    border-bottom: 1px solid #262626;
}

#LogoLabel {
    font-size: 16px;
    font-weight: 600;
    color: #e8e8e8;
}

#MenuSeparator {
    background-color: #262626;
}

#MenuList {
    background-color: transparent;
    border: none;
}

#MenuList::item {
    color: rgba(255, 255, 255, 0.65);
    font-size: 14px;
    height: 44px;
    padding: 0 16px;
    border-radius: 8px;
    margin: 2px 0;
}

#MenuList::item:hover {
    background-color: rgba(255, 255, 255, 0.08);
    color: #ffffff;
}

#MenuList::item:selected {
    background-color: #177ddc;
    color: #ffffff;
}

#MenuFooter {
    background-color: #1a1a1a;
    border-top: 1px solid #262626;
}

#VersionLabel {
    font-size: 12px;
    color: #595959;
}

/* ============================================================================
   标题栏 - 暗色
   ============================================================================ */

#TitleBar {
    background-color: #1f1f1f;
    border-bottom: 1px solid #303030;
}

#TitleBarSpacer {
    background-color: #141414;
    border-right: 1px solid #303030;
}

#Breadcrumb {
    color: #b0b0b0;
    font-size: 15px;
    font-weight: 600;
    letter-spacing: 0.3px;
}

#ThemeButton, #UserButton, #MinimizeButton {
    background-color: transparent;
    border: none;
    border-radius: 6px;
}

#ThemeButton:hover, #UserButton:hover, #MinimizeButton:hover {
    background-color: #303030;
}

#CloseButton {
    background-color: transparent;
    border: none;
    border-radius: 6px;
}

#CloseButton:hover {
    background-color: #ff4d4f;
}

/* ============================================================================
   按钮样式 - 暗色
   ============================================================================ */

QPushButton {
    min-height: 36px;
    min-width: 80px;
    padding: 0 20px;
    border-radius: 8px;
    border: 1px solid #4a4a4a;
    background-color: #2a2a2a;
    color: #e8e8e8;
    font-weight: 500;
}

QPushButton:hover {
    border-color: #177ddc;
    color: #69c0ff;
    background-color: #303030;
}

QPushButton:pressed {
    background-color: #1a3a5c;
}

QPushButton:disabled {
    background-color: #262626;
    color: #595959;
    border-color: #3a3a3a;
}

/* Primary Button */
QPushButton[buttonType="primary"],
QPushButton[primary="true"] {
    background-color: #177ddc;
    color: #ffffff;
    border: none;
}

QPushButton[buttonType="primary"]:hover,
QPushButton[primary="true"]:hover {
    background-color: #1890ff;
}

QPushButton[buttonType="primary"]:pressed,
QPushButton[primary="true"]:pressed {
    background-color: #0958d9;
}

/* Danger Button */
QPushButton[buttonType="danger"] {
    background-color: #d32029;
    color: #ffffff;
    border: none;
}

QPushButton[buttonType="danger"]:hover {
    background-color: #e84749;
}

/* Success Button */
QPushButton[buttonType="success"] {
    background-color: #49aa19;
    color: #ffffff;
    border: none;
}

QPushButton[buttonType="success"]:hover {
    background-color: #6abe39;
}

/* ============================================================================
   输入框样式 - 暗色
   ============================================================================ */

QLineEdit, QTextEdit, QPlainTextEdit {
    min-height: 36px;
    padding: 8px 12px;
    border-radius: 8px;
    border: 1px solid #4a4a4a;
    background-color: #2a2a2a;
    color: #e8e8e8;
    selection-background-color: #177ddc;
    selection-color: #ffffff;
}

QLineEdit:hover, QTextEdit:hover {
    border-color: #177ddc;
}

QLineEdit:focus, QTextEdit:focus {
    border-color: #1890ff;
}

QLineEdit:disabled, QTextEdit:disabled {
    background-color: #1f1f1f;
    color: #595959;
}

/* ============================================================================
   下拉框 / 日期选择器 - 暗色
   ============================================================================ */

QComboBox, QDateEdit, QTimeEdit, QDateTimeEdit {
    min-height: 36px;
    padding: 8px 12px;
    border-radius: 8px;
    border: 1px solid #4a4a4a;
    background-color: #2a2a2a;
    color: #e8e8e8;
}

QComboBox:hover, QDateEdit:hover, QTimeEdit:hover {
    border-color: #177ddc;
}

QComboBox::drop-down {
    border: none;
    width: 30px;
}

QComboBox QAbstractItemView {
    background-color: #2a2a2a;
    border: 1px solid #4a4a4a;
    border-radius: 8px;
    selection-background-color: #1a3a5c;
    selection-color: #69c0ff;
    padding: 4px;
}

QComboBox QAbstractItemView::item {
    min-height: 36px;
    padding: 8px 12px;
    color: #e8e8e8;
}

QComboBox QAbstractItemView::item:hover {
    background-color: #363636;
}

/* ============================================================================
   复选框 / 单选框 - 暗色
   ============================================================================ */

QCheckBox, QRadioButton {
    color: #e8e8e8;
    spacing: 8px;
}

QCheckBox::indicator {
    width: 18px;
    height: 18px;
    border-radius: 4px;
    border: 1px solid #4a4a4a;
    background-color: #2a2a2a;
}

QCheckBox::indicator:hover {
    border-color: #177ddc;
}

QCheckBox::indicator:checked {
    background-color: #177ddc;
    border-color: #177ddc;
}

QRadioButton::indicator {
    width: 18px;
    height: 18px;
    border-radius: 9px;
    border: 1px solid #4a4a4a;
    background-color: #2a2a2a;
}

QRadioButton::indicator:checked {
    background-color: #2a2a2a;
    border: 5px solid #177ddc;
}

/* ============================================================================
   标签样式 - 暗色
   ============================================================================ */

QLabel {
    color: #e8e8e8;
    background-color: transparent;
}

/* ============================================================================
   列表样式 - 暗色
   ============================================================================ */

QListWidget, QListView {
    border: 1px solid #3a3a3a;
    border-radius: 8px;
    background-color: #262626;
    alternate-background-color: #2d2d2d;
    padding: 4px;
}

QListWidget::item, QListView::item {
    color: #e8e8e8;
    padding: 8px 12px;
    min-height: 36px;
    border-radius: 6px;
}

QListWidget::item:hover, QListView::item:hover {
    background-color: #363636;
    color: #ffffff;
}

QListWidget::item:selected, QListView::item:selected {
    background-color: #1a3a5c;
    color: #69c0ff;
}

/* ============================================================================
   表格样式 - 暗色（修复斑马纹）
   ============================================================================ */

QTableWidget, QTableView, #ModernTableView {
    border: 1px solid #3a3a3a;
    border-radius: 8px;
    background-color: #262626;
    alternate-background-color: #2d2d2d;
    gridline-color: #3a3a3a;
    selection-background-color: #1a3a5c;
    selection-color: #ffffff;
    color: #e8e8e8;
}

QHeaderView::section {
    background-color: #1f1f1f;
    color: #b0b0b0;
    font-weight: 600;
    font-size: 14px;
    padding: 12px 8px;
    border: none;
    border-bottom: 1px solid #3a3a3a;
}

QTableWidget::item, QTableView::item {
    padding: 10px 8px;
    color: #e8e8e8;
}

QTableWidget::item:hover, QTableView::item:hover {
    background-color: #363636;
}

QTableWidget::item:selected, QTableView::item:selected {
    background-color: #1a3a5c;
    color: #ffffff;
}

/* ============================================================================
   滚动区域 - 暗色
   ============================================================================ */

QScrollArea {
    border: none;
    background-color: transparent;
}

QScrollArea > QWidget > QWidget {
    background-color: transparent;
}

/* ============================================================================
   滚动条样式 - 暗色
   ============================================================================ */

QScrollBar:vertical {
    background-color: transparent;
    width: 8px;
}

QScrollBar::handle:vertical {
    background-color: rgba(255, 255, 255, 0.2);
    border-radius: 4px;
    min-height: 40px;
}

QScrollBar::handle:vertical:hover {
    background-color: rgba(255, 255, 255, 0.3);
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0;
}

QScrollBar:horizontal {
    background-color: transparent;
    height: 8px;
}

QScrollBar::handle:horizontal {
    background-color: rgba(255, 255, 255, 0.2);
    border-radius: 4px;
    min-width: 40px;
}

QScrollBar::handle:horizontal:hover {
    background-color: rgba(255, 255, 255, 0.3);
}

QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
    width: 0;
}

/* ============================================================================
   进度条样式 - 暗色
   ============================================================================ */

QProgressBar {
    border: none;
    border-radius: 4px;
    background-color: #2a2a2a;
    text-align: center;
    color: #e8e8e8;
    min-height: 8px;
}

QProgressBar::chunk {
    border-radius: 4px;
    background-color: #177ddc;
}

/* ============================================================================
   Slider 滑块 - 暗色
   ============================================================================ */

QSlider::groove:horizontal {
    height: 4px;
    background-color: #3a3a3a;
    border-radius: 2px;
}

QSlider::handle:horizontal {
    width: 16px;
    height: 16px;
    background-color: #177ddc;
    border-radius: 8px;
    margin: -6px 0;
}

QSlider::handle:horizontal:hover {
    background-color: #1890ff;
}

/* ============================================================================
   数字输入框 - 暗色
   ============================================================================ */

QSpinBox, QDoubleSpinBox {
    min-height: 36px;
    padding: 8px 12px;
    border-radius: 8px;
    border: 1px solid #4a4a4a;
    background-color: #2a2a2a;
    color: #e8e8e8;
}

QSpinBox:hover, QDoubleSpinBox:hover {
    border-color: #177ddc;
}

QSpinBox:focus, QDoubleSpinBox:focus {
    border-color: #1890ff;
}

QSpinBox::up-button, QSpinBox::down-button,
QDoubleSpinBox::up-button, QDoubleSpinBox::down-button {
    background-color: #3a3a3a;
    border: none;
}

QSpinBox::up-button:hover, QSpinBox::down-button:hover,
QDoubleSpinBox::up-button:hover, QDoubleSpinBox::down-button:hover {
    background-color: #4a4a4a;
}

/* ============================================================================
   分组框样式 - 暗色
   ============================================================================ */

QGroupBox {
    border: 1px solid #3a3a3a;
    border-radius: 8px;
    margin-top: 12px;
    padding: 16px;
    background-color: #262626;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 12px;
    top: -6px;
    padding: 0 8px;
    background-color: #262626;
    color: #e8e8e8;
    font-weight: 600;
}

/* ============================================================================
   标签页样式 - 暗色
   ============================================================================ */

QTabWidget::pane {
    border: 1px solid #3a3a3a;
    border-radius: 8px;
    background-color: #262626;
    top: -1px;
}

QTabBar::tab {
    background-color: transparent;
    color: #b0b0b0;
    padding: 10px 20px;
    border-bottom: 2px solid transparent;
}

QTabBar::tab:hover {
    color: #e8e8e8;
}

QTabBar::tab:selected {
    color: #69c0ff;
    border-bottom: 2px solid #177ddc;
    font-weight: 600;
}

/* ============================================================================
   对话框样式 - 暗色
   ============================================================================ */

QDialog {
    background-color: #262626;
    border-radius: 12px;
}

/* ============================================================================
   菜单样式 - 暗色
   ============================================================================ */

QMenuBar {
    background-color: #1f1f1f;
    border-bottom: 1px solid #3a3a3a;
    padding: 4px;
}

QMenuBar::item {
    padding: 8px 16px;
    border-radius: 6px;
    color: #e8e8e8;
}

QMenuBar::item:selected {
    background-color: #303030;
}

QMenu {
    background-color: #262626;
    border: 1px solid #3a3a3a;
    border-radius: 8px;
    padding: 4px;
}

QMenu::item {
    padding: 8px 24px 8px 16px;
    border-radius: 4px;
    color: #e8e8e8;
}

QMenu::item:selected {
    background-color: #1a3a5c;
    color: #69c0ff;
}

QMenu::separator {
    height: 1px;
    background-color: #3a3a3a;
    margin: 4px 8px;
}

#NewsTicker {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 rgba(35, 38, 50, 0.96),
        stop:1 rgba(26, 28, 38, 0.96));
    border-radius: 18px;
    border: 1px solid rgba(64, 158, 255, 0.18);
    padding: 6px 14px;
}

#NewsTickerLabel {
    color: #f5f7ff;
    font-weight: 600;
    letter-spacing: 0.2px;
}

/* ============================================================================
   工具提示 - 暗色
   ============================================================================ */

QToolTip {
    background-color: rgba(50, 50, 50, 0.95);
    color: #e8e8e8;
    border: 1px solid #4a4a4a;
    border-radius: 6px;
    padding: 8px 12px;
    font-size: 12px;
}

/* ============================================================================
   日历组件 - 暗色
   ============================================================================ */

QCalendarWidget {
    background-color: #262626;
}

QCalendarWidget QWidget {
    alternate-background-color: #2d2d2d;
    color: #e8e8e8;
}

QCalendarWidget QToolButton {
    color: #e8e8e8;
    background-color: transparent;
}

QCalendarWidget QToolButton:hover {
    background-color: #363636;
}

QCalendarWidget QMenu {
    background-color: #262626;
}

/* ============================================================================
   实时画面页面组件 - 暗色
   ============================================================================ */

#RecognitionPage {
    background-color: #1a1a1a;
}

#AttendanceHeader {
    background: transparent;
}

#AttendanceDateLabel {
    color: #bfbfbf;
    font-size: 12px;
    font-weight: 600;
}

#AttendanceFilterBar {
    background: transparent;
}

#AttendanceFilterButton {
    background: rgba(24, 144, 255, 0.18);
    border: 1px solid rgba(24, 144, 255, 0.35);
    color: #69b1ff;
    padding: 4px 10px;
    border-radius: 13px;
}

#AttendanceFilterButton:hover {
    background: rgba(24, 144, 255, 0.28);
}

#AttendanceFilterButton[active="true"] {
    background: #1677ff;
    border-color: #1677ff;
    color: #ffffff;
}

#AttendanceActionButton {
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.12);
    color: #e8e8e8;
    padding: 4px 10px;
    border-radius: 8px;
}

#AttendanceActionButton:hover {
    background: rgba(255, 255, 255, 0.14);
}

#VideoContainer {
    background-color: transparent;
}

/* 用户信息面板 - 现代化设计（暗色） */
#UserInfoPanel {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 rgba(10, 10, 15, 0.98), stop:1 rgba(20, 20, 30, 0.98));
    border-bottom-left-radius: 12px;
    border-bottom-right-radius: 12px;
}

/* 头像容器 */
#AvatarContainer {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
        stop:0 #6366f1, stop:1 #a855f7);
    border-radius: 34px;
    border: 3px solid rgba(255, 255, 255, 0.15);
}

#AvatarImage {
    border-radius: 32px;
    background: rgba(255, 255, 255, 0.08);
    border: 2px solid rgba(255, 255, 255, 0.2);
    color: #ffffff;
    font-size: 32px;
}

/* 用户名 */
#UserNameLabel {
    color: #f0f0f0;
    font-size: 20px;
    font-weight: 700;
    background: transparent;
    letter-spacing: 0.3px;
}

/* 签到/签退成功状态标签 - 现代化设计 */
#AttendanceStatusLabel {
    color: white;
    padding: 8px 18px;
    border-radius: 20px;
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 1px;
}

/* 签到成功 - 翠绿色渐变 + 发光边框 */
#AttendanceStatusLabel[checkType="checkin"] {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
        stop:0 #10b981, stop:0.5 #34d399, stop:1 #059669);
    border: 2px solid rgba(52, 211, 153, 0.6);
}

/* 签退成功 - 天蓝色渐变 + 发光边框 */
#AttendanceStatusLabel[checkType="checkout"] {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
        stop:0 #0ea5e9, stop:0.5 #38bdf8, stop:1 #0284c7);
    border: 2px solid rgba(56, 189, 248, 0.6);
}

/* 元信息标签（工号、部门） */
#UserMetaLabel {
    color: rgba(255, 255, 255, 0.6);
    font-size: 13px;
    background: transparent;
}

#MetaSeparator {
    color: rgba(255, 255, 255, 0.3);
    font-size: 13px;
    background: transparent;
}

/* 右侧指标容器 */
#MetricsContainer {
    background: transparent;
}

/* 指标卡片 */
#MetricCard {
    background: rgba(255, 255, 255, 0.06);
    border-radius: 12px;
    border: 1px solid rgba(255, 255, 255, 0.08);
}

#MetricCard:hover {
    background: rgba(255, 255, 255, 0.1);
    border-color: rgba(255, 255, 255, 0.12);
}

/* 指标数值 */
#MetricValue {
    color: #e8e8e8;
    font-size: 18px;
    font-weight: 700;
    background: transparent;
}

/* 指标标题 */
#MetricTitle {
    color: rgba(255, 255, 255, 0.45);
    font-size: 11px;
    font-weight: 500;
    background: transparent;
}

/* 每日一句容器 */
#SentenceContainer {
    background: transparent;
}

#SentenceEnLabel {
    color: rgba(105, 192, 255, 0.95);
    font-size: 16px;
    font-style: italic;
    font-family: "Georgia", "Times New Roman", serif;
    background: transparent;
}

#SentenceCnLabel {
    color: rgba(255, 255, 255, 0.5);
    font-size: 14px;
    background: transparent;
}

/* 兼容旧标签 */
#UserInfoLabel {
    color: rgba(255,255,255,0.7);
    font-size: 14px;
    background: transparent;
}

#UserDetailLabel {
    color: rgba(255,255,255,0.5);
    font-size: 13px;
    background: transparent;
}

#StatusContainer {
    background: transparent;
}

#StatusTitle {
    color: #8c8c8c;
    font-size: 12px;
    background: transparent;
}

#StatusValue {
    color: #52c41a;
    font-size: 16px;
    font-weight: 600;
    background: transparent;
}

#FpsValue {
    color: #69c0ff;
    font-size: 16px;
    font-weight: 600;
    background: transparent;
}

#GhostButton {
    background-color: transparent;
    border: 1px solid #177ddc;
    color: #69c0ff;
    border-radius: 8px;
    padding: 0 16px;
    font-weight: 500;
}

#GhostButton:hover {
    background-color: #1a3a5c;
}

/* ========================================
   信息栏（天气 + 考勤统计）- 暗色主题增强版
   ======================================== */

#InfoBar {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 rgba(20, 30, 45, 0.95), stop:0.5 rgba(25, 35, 50, 0.95), stop:1 rgba(20, 30, 45, 0.95));
    border-bottom: 1px solid rgba(23, 125, 220, 0.2);
}

#InfoBarCard {
    background: rgba(255, 255, 255, 0.05);
    border-radius: 12px;
    border: 1px solid rgba(255, 255, 255, 0.08);
}

#InfoBarCardTitle {
    color: #6b6b6b;
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.5px;
    background: transparent;
}

/* 天气卡片 - 暗色主题特殊样式 */
#WeatherCard {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
        stop:0 rgba(23, 125, 220, 0.2), stop:1 rgba(138, 43, 226, 0.15));
    border-radius: 16px;
    border: 1px solid rgba(105, 192, 255, 0.25);
    min-width: 300px;
}

#WeatherTempBig {
    color: #69c0ff;
    font-size: 42px;
    font-weight: 700;
    font-family: "DIN Alternate", "SF Pro Display", "Segoe UI", sans-serif;
    background: transparent;
    min-width: 80px;
}

#WeatherCityLabel {
    color: #e8e8e8;
    font-size: 16px;
    font-weight: 600;
    background: transparent;
}

#WeatherDescLabel {
    color:rgb(10, 236, 29);
    font-size: 16px;
    font-weight: 700;
    background: transparent;
}

#InfoBarSeparator {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 transparent, stop:0.2 #404550, stop:0.8 #404550, stop:1 transparent);
}

#StatsItemLabel {
    color: #6b6b6b;
    font-size: 13px;
    font-weight: 500;
    background: transparent;
}

#StatsCheckinValue {
    color: #73d13d;
    font-size: 24px;
    font-weight: 700;
    font-family: "DIN Alternate", "SF Pro Display", "Segoe UI", sans-serif;
    background: transparent;
}

#StatsCheckoutValue {
    color: #69c0ff;
    font-size: 24px;
    font-weight: 700;
    font-family: "DIN Alternate", "SF Pro Display", "Segoe UI", sans-serif;
    background: transparent;
}

#StatsAbnormalValue {
    color: #6b6b6b;
    font-size: 24px;
    font-weight: 700;
    font-family: "DIN Alternate", "SF Pro Display", "Segoe UI", sans-serif;
    background: transparent;
}

#StatsAbnormalValue[hasAlert="true"] {
    color: #ff7875;
}

#ModeCard {
    background: rgba(255, 255, 255, 0.06);
    border-radius: 16px;
    border: 2px solid rgba(115, 209, 61, 0.3);
    min-width: 100px;
}

#ModeTitle {
    color: #6b6b6b;
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.5px;
    background: transparent;
}

#CheckModeLabel {
    font-size: 22px;
    font-weight: 700;
    color: #73d13d;
    background: transparent;
}

#CheckModeLabel[mode="checkout"] {
    color: #ffc53d;
}

/* ========================================
   综合状态栏（时钟 + 检测状态）- 暗色主题增强版
   ======================================== */

#DetectionStatusBar {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 rgba(20, 25, 35, 0.95), stop:0.5 rgba(30, 35, 45, 0.95), stop:1 rgba(20, 25, 35, 0.95));
    border-top: 1px solid rgba(23, 125, 220, 0.15);
    border-bottom: 1px solid rgba(23, 125, 220, 0.2);
}

#ClockCard {
    background: rgba(255, 255, 255, 0.05);
    border-radius: 12px;
    border: 1px solid rgba(255, 255, 255, 0.08);
    min-width: 200px;
}

#ClockLabel {
    color: #69c0ff;
    font-size: 32px;
    font-weight: 700;
    font-family: "JetBrains Mono", "SF Mono", "Fira Code", "Consolas", monospace;
    letter-spacing: 2px;
    background: transparent;
}

#DateLabel {
    color: #d9d9d9;
    font-size: 15px;
    font-weight: 600;
    letter-spacing: 0.6px;
    background: transparent;
}

#StatusBarSeparator {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 transparent, stop:0.2 #404550, stop:0.8 #404550, stop:1 transparent);
}

#FaceDetectionCard {
    background: rgba(255, 255, 255, 0.05);
    border-radius: 12px;
    border: 1px solid rgba(255, 255, 255, 0.08);
}

#FaceCardTitle {
    color: #6b6b6b;
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.5px;
    background: transparent;
}

#FaceCountValue {
    font-size: 28px;
    font-weight: 800;
    font-family: "DIN Alternate", "SF Pro Display", "Segoe UI", sans-serif;
    background: transparent;
}

#HolidayCard {
    background: rgba(28, 30, 40, 0.82);
    border-radius: 12px;
    border: 1px solid rgba(64, 158, 255, 0.18);
}

#HolidayTitle {
    color: #69c0ff;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.2px;
}

#HolidayStatus {
    color: #69c0ff;  /* 亮蓝，突出状态 */
    font-size: 14px;
    font-weight: 700;
}

#HolidayCountdown {
    color: #9fb4d0;  /* 柔和蓝灰，次级信息 */
    font-size: 13px;
}

#FaceCountValue[status="active"] {
    color: #73d13d;
}

#FaceCountValue[status="inactive"] {
    color: #4a4a4a;
}

#ProgressCard {
    background: rgba(255, 255, 255, 0.05);
    border-radius: 12px;
    border: 1px solid rgba(255, 255, 255, 0.08);
    min-width: 200px;
}

#DetectionStatusLabel {
    color: #a0a0a0;
    font-size: 14px;
    font-weight: 600;
    background: transparent;
}

#DetectionProgressBar {
    background-color: rgba(255, 255, 255, 0.08);
    border: none;
    border-radius: 4px;
}

#DetectionProgressBar::chunk {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #177ddc, stop:0.5 #36cfc9, stop:1 #73d13d);
    border-radius: 4px;
}

/* ========================================
   设置页面 - 暗色主题
   ======================================== */

#SettingsScroll {
    background: transparent;
    border: none;
}

#SettingsContent {
    background: transparent;
}

#PageTitle {
    font-size: 28px;
    font-weight: 700;
    color: #e8e8e8;
    background: transparent;
    padding-bottom: 8px;
}

/* 概览卡片 */
#OverviewCard {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 rgba(23, 125, 220, 0.1), stop:0.5 rgba(45, 52, 64, 0.95), stop:1 rgba(23, 125, 220, 0.1));
    border: 1px solid rgba(105, 192, 255, 0.15);
}

#OverviewIcon {
    font-size: 24px;
    background: transparent;
}

#OverviewValue {
    font-size: 16px;
    font-weight: 600;
    color: #e8e8e8;
    background: transparent;
}

/* 分组标题 */
#SectionHeader {
    background: transparent;
}

#SectionIcon {
    font-size: 20px;
    background: rgba(105, 192, 255, 0.15);
    border-radius: 8px;
    color: #69c0ff;
}

#SectionTitle {
    font-size: 15px;
    font-weight: 600;
    color: #e8e8e8;
    background: transparent;
}

#SectionSubtitle {
    font-size: 12px;
    color: #6b6b6b;
    background: transparent;
}

/* 设置标签 */
#SettingsLabel {
    font-size: 14px;
    color: #a0a0a0;
    background: transparent;
}

#SettingsHint {
    font-size: 12px;
    color: #6b6b6b;
    background: transparent;
}

/* 分隔线 */
#SettingsSeparator {
    background: #3a3f4b;
    max-height: 1px;
    min-height: 1px;
}

/* 表单控件 - SpinBox (暗色) */
#SettingsSpinBox,
QSpinBox,
QDoubleSpinBox {
    min-height: 36px;
    padding: 0 12px;
    border: 1px solid #3a3f4b;
    border-radius: 8px;
    background: #2d3440;
    color: #e8e8e8;
    font-size: 14px;
}

#SettingsSpinBox:hover,
QSpinBox:hover,
QDoubleSpinBox:hover {
    border-color: #177ddc;
}

#SettingsSpinBox:focus,
QSpinBox:focus,
QDoubleSpinBox:focus {
    border-color: #69c0ff;
    outline: none;
}

#SettingsSpinBox::up-button,
#SettingsSpinBox::down-button,
QSpinBox::up-button,
QSpinBox::down-button,
QDoubleSpinBox::up-button,
QDoubleSpinBox::down-button {
    width: 24px;
    border: none;
    background: transparent;
}

#SettingsSpinBox::up-button:hover,
#SettingsSpinBox::down-button:hover,
QSpinBox::up-button:hover,
QSpinBox::down-button:hover,
QDoubleSpinBox::up-button:hover,
QDoubleSpinBox::down-button:hover {
    background: rgba(105, 192, 255, 0.15);
}

/* 表单控件 - TimeEdit (暗色) */
#SettingsTimeEdit,
QTimeEdit {
    min-height: 36px;
    padding: 0 12px;
    border: 1px solid #3a3f4b;
    border-radius: 8px;
    background: #2d3440;
    color: #e8e8e8;
    font-size: 14px;
}

#SettingsTimeEdit:hover,
QTimeEdit:hover {
    border-color: #177ddc;
}

#SettingsTimeEdit:focus,
QTimeEdit:focus {
    border-color: #69c0ff;
}

#SettingsTimeEdit::up-button,
#SettingsTimeEdit::down-button,
QTimeEdit::up-button,
QTimeEdit::down-button {
    width: 24px;
    border: none;
    background: transparent;
}

/* 表单控件 - LineEdit (暗色) */
#SettingsLineEdit,
QLineEdit {
    min-height: 36px;
    padding: 0 12px;
    border: 1px solid #3a3f4b;
    border-radius: 8px;
    background: #2d3440;
    color: #e8e8e8;
    font-size: 14px;
}

#SettingsLineEdit:hover,
QLineEdit:hover {
    border-color: #177ddc;
}

#SettingsLineEdit:focus,
QLineEdit:focus {
    border-color: #69c0ff;
    outline: none;
}

#SettingsLineEdit:disabled,
QLineEdit:disabled {
    background: #1f2430;
    color: #4a4a4a;
}

/* 表单控件 - ComboBox (暗色) */
#SettingsCombo,
QComboBox {
    min-height: 36px;
    padding: 0 12px;
    padding-right: 32px;
    border: 1px solid #3a3f4b;
    border-radius: 8px;
    background: #2d3440;
    color: #e8e8e8;
    font-size: 14px;
}

#SettingsCombo:hover,
QComboBox:hover {
    border-color: #177ddc;
}

#SettingsCombo:focus,
QComboBox:focus {
    border-color: #69c0ff;
}

#SettingsCombo::drop-down,
QComboBox::drop-down {
    border: none;
    width: 32px;
    background: transparent;
}

#SettingsCombo QAbstractItemView,
QComboBox QAbstractItemView {
    border: 1px solid #3a3f4b;
    border-radius: 8px;
    background: #2d3440;
    selection-background-color: rgba(105, 192, 255, 0.2);
    selection-color: #69c0ff;
    padding: 4px;
}

#SettingsCombo QAbstractItemView::item,
QComboBox QAbstractItemView::item {
    min-height: 32px;
    padding: 4px 12px;
    border-radius: 4px;
    color: #e8e8e8;
}

#SettingsCombo QAbstractItemView::item:hover,
QComboBox QAbstractItemView::item:hover {
    background: #3a3f4b;
}

#SettingsCombo:disabled,
QComboBox:disabled {
    background: #1f2430;
    color: #4a4a4a;
}

/* 表单控件 - CheckBox (暗色) */
#SettingsCheckBox,
QCheckBox {
    font-size: 14px;
    color: #e8e8e8;
    spacing: 8px;
    background: transparent;
}

#SettingsCheckBox::indicator,
QCheckBox::indicator {
    width: 18px;
    height: 18px;
    border: 2px solid #3a3f4b;
    border-radius: 4px;
    background: #2d3440;
}

#SettingsCheckBox::indicator:hover,
QCheckBox::indicator:hover {
    border-color: #177ddc;
}

#SettingsCheckBox::indicator:checked,
QCheckBox::indicator:checked {
    background: #177ddc;
    border-color: #177ddc;
}

#SettingsCheckBox::indicator:checked:hover,
QCheckBox::indicator:checked:hover {
    background: #69c0ff;
    border-color: #69c0ff;
}

#SettingsCheckBox:disabled,
QCheckBox:disabled {
    color: #4a4a4a;
}

#SettingsCheckBox::indicator:disabled,
QCheckBox::indicator:disabled {
    background: #1f2430;
    border-color: #3a3f4b;
}

/* 表单控件 - Slider (暗色) */
#SettingsSlider,
QSlider::groove:horizontal {
    height: 6px;
    background: #3a3f4b;
    border-radius: 3px;
}

#SettingsSlider::sub-page:horizontal,
QSlider::sub-page:horizontal {
    background: #177ddc;
    border-radius: 3px;
}

#SettingsSlider::handle:horizontal,
QSlider::handle:horizontal {
    width: 18px;
    height: 18px;
    margin: -6px 0;
    background: #2d3440;
    border: 2px solid #177ddc;
    border-radius: 9px;
}

#SettingsSlider::handle:horizontal:hover,
QSlider::handle:horizontal:hover {
    background: #3a3f4b;
}

#VolumeLabel {
    font-size: 14px;
    font-weight: 600;
    color: #69c0ff;
    background: transparent;
}

/* 按钮 - 次要按钮 (暗色) */
#SecondaryButton {
    min-height: 36px;
    min-width: 100px;
    padding: 0 16px;
    border-radius: 8px;
    border: 1px solid #3a3f4b;
    background: #2d3440;
    color: #a0a0a0;
    font-size: 14px;
    font-weight: 500;
}

#SecondaryButton:hover {
    border-color: #177ddc;
    color: #69c0ff;
}

#SecondaryButton:pressed {
    border-color: #69c0ff;
    color: #91d5ff;
}

/* 按钮 - 主要按钮 (暗色) */
#PrimaryButton {
    min-height: 40px;
    min-width: 120px;
    padding: 0 24px;
    border-radius: 8px;
    border: none;
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #177ddc, stop:1 #0958d9);
    color: #ffffff;
    font-size: 15px;
    font-weight: 600;
}

#PrimaryButton:hover {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #69c0ff, stop:1 #177ddc);
}

#PrimaryButton:pressed {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #0958d9, stop:1 #003eb3);
}

/* 底部操作栏 (暗色) */
#BottomBar {
    background: transparent;
    border-top: 1px solid #3a3f4b;
}
#FpsValue {
    padding: 0 4px 0 2px;
}

#RegisterButton {
    border-radius: 10px;
    padding: 0 18px;
    font-weight: 600;
    letter-spacing: 0.5px;
}

/* ========================================
   智能统计看板
   ======================================== */

#DashboardScroll {
    background: transparent;
    border: none;
}

#DashboardContent {
    background: transparent;
}

#DashboardHeader {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #141414, stop:0.5 #1f1f1f, stop:1 #1a1a1a);
    border: 1px solid rgba(24, 144, 255, 0.2);
    border-radius: 16px;
}

#DashboardTitle {
    font-size: 24px;
    font-weight: 700;
    color: #f0f0f0;
    background: transparent;
}

#DashboardSubtitle {
    font-size: 13px;
    color: #8c8c8c;
    background: transparent;
}

#DashboardFilterCombo {
    min-width: 120px;
}

#DashboardRefreshButton {
    min-height: 36px;
    padding: 0 18px;
    border-radius: 8px;
}

#DashboardMetaTag {
    background: #111b26;
    color: #69c0ff;
    border-radius: 999px;
    padding: 4px 10px;
    font-size: 12px;
}

#DashboardMetaTag[tone="neutral"] {
    background: #1f1f1f;
    color: #8c8c8c;
}

#DashboardKpiCard {
    background: #1f1f1f;
    border: 1px solid #303030;
    border-radius: 12px;
}

#DashboardKpiIcon {
    background: #0b1d33;
    border-radius: 10px;
    min-width: 36px;
    min-height: 36px;
}

#DashboardKpiTitle {
    font-size: 12px;
    color: #8c8c8c;
    background: transparent;
}

#DashboardKpiValue {
    font-size: 22px;
    font-weight: 700;
    background: transparent;
}

#DashboardKpiSub {
    font-size: 12px;
    color: #8c8c8c;
    background: transparent;
}

#DashboardLegendDot {
    border-radius: 5px;
    background: #69c0ff;
}

#DashboardLegendDot[tone="warning"] {
    background: #ffa940;
}

#DashboardLegendLabel {
    font-size: 12px;
    color: #8c8c8c;
    background: transparent;
}

#DashboardSectionTitle {
    font-size: 13px;
    font-weight: 600;
    color: #d9d9d9;
    background: transparent;
}

#DashboardInsightItem {
    background: #262626;
    border: 1px solid #303030;
    border-radius: 10px;
}

#DashboardInsightText {
    color: #bfbfbf;
    background: transparent;
}

#DashboardInsightAction {
    min-height: 28px;
    padding: 0 12px;
    border-radius: 6px;
    font-size: 12px;
}

#DashboardAlertItem {
    background: #1f1f1f;
    border: 1px solid #303030;
    border-radius: 12px;
}

#DashboardAlertAvatar {
    background: #112a45;
    color: #69c0ff;
    border-radius: 18px;
    font-weight: 600;
}

#DashboardAlertName {
    font-weight: 600;
    color: #f0f0f0;
}

#DashboardAlertTime {
    color: #8c8c8c;
    font-size: 12px;
}

#DashboardBadge {
    padding: 2px 10px;
    border-radius: 999px;
    font-size: 11px;
}

#DashboardBadge[badgeType="late"] {
    background: #2b1d0f;
    color: #ffa940;
}

#DashboardBadge[badgeType="early"] {
    background: #2a1215;
    color: #ff7875;
}

#DashboardRankName {
    font-size: 12px;
    color: #8c8c8c;
}

#DashboardRankValue {
    font-size: 12px;
    color: #f0f0f0;
    font-weight: 600;
}

QProgressBar#DashboardRankBar {
    background: #303030;
    border-radius: 4px;
}

QProgressBar#DashboardRankBar::chunk {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #69c0ff, stop:1 #177ddc);
    border-radius: 4px;
}

#DashboardEmptyText {
    color: #8c8c8c;
    font-size: 12px;
    background: transparent;
}

/* ========================================
   AI 对话面板
   ======================================== */

#AiChatScroll {
    background: transparent;
    border: none;
}

#AiChatContainer {
    background: transparent;
}

#AiChatBubble {
    background: #262626;
    border-radius: 12px;
    border: 1px solid #303030;
}

#AiChatBubble[role="assistant"] {
    background: #112a45;
    border: 1px solid #15395b;
}

#AiChatBubble[role="user"] {
    background: #162312;
    border: 1px solid #274916;
}

#AiChatText {
    color: #f0f0f0;
    font-size: 14px;
    background: transparent;
}

#AiChatInputRow {
    background: transparent;
}

#AiQuickRow {
    background: transparent;
}

#AiQuickButton {
    min-height: 30px;
    padding: 0 14px;
    border-radius: 999px;
    border: 1px solid #15395b;
    background-color: #112a45;
    color: #69c0ff;
    font-weight: 600;
}

#AiQuickButton:hover {
    background-color: #15395b;
}

#AiChatInput {
    min-height: 40px;
    padding: 8px 12px;
    border-radius: 10px;
    border: 1px solid #303030;
    background-color: #1f1f1f;
    color: #f0f0f0;
}

#AiChatSendButton {
    min-height: 40px;
    min-width: 80px;
    padding: 0 16px;
    border-radius: 10px;
    border: none;
    background-color: #177ddc;
    color: #ffffff;
    font-weight: 600;
}

#AiChatSendButton:hover {
    background-color: #3c9ae8;
}
