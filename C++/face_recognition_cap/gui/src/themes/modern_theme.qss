/**
 * ================================================================================
 * Modern Light Theme - Face Recognition System
 * ================================================================================
 * Version: 2.2
 * ================================================================================
 */

/* ============================================================================
   全局样式
   ============================================================================ */

* {
    outline: none;
    font-size: 14px;
}

QWidget {
    font-family: "Microsoft YaHei UI", "Segoe UI", "PingFang SC", sans-serif;
    font-size: 14px;
    color: #262626;
    background-color: transparent;
}

QMainWindow {
    background-color: #f5f5f7;
}

/* ============================================================================
   卡片组件 - 关键！
   ============================================================================ */

#CardWidget {
    background-color: #ffffff;
    border-radius: 12px;
    border: 1px solid #e8e8e8;
}

#CardWidget[cardVariant="dark"] {
    background-color: #1f1f1f;
    border: none;
}

#CardWidget[cardVariant="ghost"] {
    background-color: transparent;
    border: 1px dashed #d9d9d9;
}

#CardTitle {
    font-size: 16px;
    font-weight: 600;
    color: #262626;
    background: transparent;
}

#CardSubtitle {
    font-size: 13px;
    color: #8c8c8c;
    background: transparent;
}

#CardHeader, #CardBody, #CardFooter {
    background: transparent;
}

/* ============================================================================
   按钮样式
   ============================================================================ */

QPushButton {
    min-height: 36px;
    min-width: 80px;
    padding: 0 20px;
    border-radius: 8px;
    border: 1px solid #d9d9d9;
    background-color: #ffffff;
    color: #262626;
    font-weight: 500;
}

QPushButton:hover {
    border-color: #40a9ff;
    color: #40a9ff;
}

QPushButton:pressed {
    border-color: #096dd9;
    color: #096dd9;
}

QPushButton:disabled {
    background-color: #f5f5f5;
    color: #bfbfbf;
    border-color: #d9d9d9;
}

/* Primary Button */
QPushButton[buttonType="primary"],
QPushButton[primary="true"] {
    background-color: #1890ff;
    color: #ffffff;
    border: none;
}

QPushButton[buttonType="primary"]:hover,
QPushButton[primary="true"]:hover {
    background-color: #40a9ff;
}

QPushButton[buttonType="primary"]:pressed,
QPushButton[primary="true"]:pressed {
    background-color: #096dd9;
}

/* Danger Button */
QPushButton[buttonType="danger"] {
    background-color: #ff4d4f;
    color: #ffffff;
    border: none;
}

QPushButton[buttonType="danger"]:hover {
    background-color: #ff7875;
}

/* Success Button */
QPushButton[buttonType="success"] {
    background-color: #52c41a;
    color: #ffffff;
    border: none;
}

QPushButton[buttonType="success"]:hover {
    background-color: #73d13d;
}

/* ============================================================================
   输入框样式
   ============================================================================ */

QLineEdit, QTextEdit, QPlainTextEdit {
    min-height: 36px;
    padding: 8px 12px;
    border-radius: 8px;
    border: 1px solid #d9d9d9;
    background-color: #ffffff;
    color: #262626;
    selection-background-color: #1890ff;
    selection-color: #ffffff;
}

QLineEdit:hover, QTextEdit:hover {
    border-color: #40a9ff;
}

QLineEdit:focus, QTextEdit:focus {
    border-color: #1890ff;
}

QLineEdit:disabled, QTextEdit:disabled {
    background-color: #f5f5f5;
    color: #bfbfbf;
}

/* ============================================================================
   下拉框 / 日期选择器 / 时间选择器
   ============================================================================ */

QComboBox, QDateEdit, QTimeEdit, QDateTimeEdit {
    min-height: 36px;
    padding: 8px 12px;
    border-radius: 8px;
    border: 1px solid #d9d9d9;
    background-color: #ffffff;
    color: #262626;
}

QComboBox:hover, QDateEdit:hover, QTimeEdit:hover {
    border-color: #40a9ff;
}

QComboBox::drop-down {
    border: none;
    width: 30px;
}

QComboBox QAbstractItemView {
    border: 1px solid #d9d9d9;
    border-radius: 8px;
    background-color: #ffffff;
    selection-background-color: #e6f7ff;
    padding: 4px;
}

QComboBox QAbstractItemView::item {
    min-height: 36px;
    padding: 8px 12px;
    border-radius: 4px;
    color: #262626;
}

QComboBox QAbstractItemView::item:hover {
    background-color: #f5f5f5;
}

/* ============================================================================
   复选框 / 单选框
   ============================================================================ */

QCheckBox, QRadioButton {
    spacing: 8px;
    color: #262626;
}

QCheckBox::indicator {
    width: 18px;
    height: 18px;
    border-radius: 4px;
    border: 1px solid #d9d9d9;
    background-color: #ffffff;
}

QCheckBox::indicator:hover {
    border-color: #1890ff;
}

QCheckBox::indicator:checked {
    background-color: #1890ff;
    border-color: #1890ff;
}

QRadioButton::indicator {
    width: 18px;
    height: 18px;
    border-radius: 9px;
    border: 1px solid #d9d9d9;
    background-color: #ffffff;
}

QRadioButton::indicator:checked {
    background-color: #ffffff;
    border: 5px solid #1890ff;
}

/* ============================================================================
   标签样式
   ============================================================================ */

QLabel {
    color: #262626;
    background-color: transparent;
}

/* ============================================================================
   列表样式
   ============================================================================ */

QListWidget, QListView {
    border: 1px solid #e8e8e8;
    border-radius: 8px;
    background-color: #ffffff;
    padding: 4px;
}

QListWidget::item, QListView::item {
    min-height: 40px;
    padding: 8px 12px;
    border-radius: 6px;
    color: #262626;
}

QListWidget::item:hover, QListView::item:hover {
    background-color: #f5f5f5;
}

QListWidget::item:selected, QListView::item:selected {
    background-color: #e6f7ff;
    color: #1890ff;
}

/* ============================================================================
   表格样式
   ============================================================================ */

QTableWidget, QTableView, #ModernTableView {
    border: 1px solid #e8e8e8;
    border-radius: 8px;
    background-color: #ffffff;
    alternate-background-color: #fafafa;
    gridline-color: #f5f5f5;
    selection-background-color: #e6f7ff;
    selection-color: #262626;
    color: #262626;
}

QHeaderView::section {
    background-color: #fafafa;
    color: #8c8c8c;
    font-weight: 600;
    font-size: 14px;
    padding: 12px 8px;
    border: none;
    border-bottom: 1px solid #f0f0f0;
}

QTableWidget::item, QTableView::item {
    padding: 10px 8px;
    color: #262626;
}

QTableWidget::item:hover, QTableView::item:hover {
    background-color: #f5f5f5;
}

QTableWidget::item:selected, QTableView::item:selected {
    background-color: #e6f7ff;
    color: #1890ff;
}

/* ============================================================================
   滚动区域
   ============================================================================ */

QScrollArea {
    border: none;
    background-color: transparent;
}

QScrollArea > QWidget > QWidget {
    background-color: transparent;
}

/* ============================================================================
   滚动条样式
   ============================================================================ */

QScrollBar:vertical {
    background-color: transparent;
    width: 8px;
    margin: 0;
}

QScrollBar::handle:vertical {
    background-color: rgba(0, 0, 0, 0.15);
    border-radius: 4px;
    min-height: 40px;
}

QScrollBar::handle:vertical:hover {
    background-color: rgba(0, 0, 0, 0.25);
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0;
}

QScrollBar:horizontal {
    background-color: transparent;
    height: 8px;
}

QScrollBar::handle:horizontal {
    background-color: rgba(0, 0, 0, 0.15);
    border-radius: 4px;
    min-width: 40px;
}

QScrollBar::handle:horizontal:hover {
    background-color: rgba(0, 0, 0, 0.25);
}

QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
    width: 0;
}

/* ============================================================================
   进度条样式
   ============================================================================ */

QProgressBar {
    border: none;
    border-radius: 4px;
    background-color: #f0f0f0;
    text-align: center;
    color: #262626;
    font-size: 12px;
    min-height: 8px;
}

QProgressBar::chunk {
    border-radius: 4px;
    background-color: #1890ff;
}

/* ============================================================================
   Slider 滑块
   ============================================================================ */

QSlider::groove:horizontal {
    height: 4px;
    background-color: #f0f0f0;
    border-radius: 2px;
}

QSlider::handle:horizontal {
    width: 16px;
    height: 16px;
    background-color: #1890ff;
    border-radius: 8px;
    margin: -6px 0;
}

QSlider::handle:horizontal:hover {
    background-color: #40a9ff;
}

/* ============================================================================
   数字输入框
   ============================================================================ */

QSpinBox, QDoubleSpinBox {
    min-height: 36px;
    padding: 8px 12px;
    border-radius: 8px;
    border: 1px solid #d9d9d9;
    background-color: #ffffff;
    color: #262626;
}

QSpinBox:hover, QDoubleSpinBox:hover {
    border-color: #40a9ff;
}

QSpinBox:focus, QDoubleSpinBox:focus {
    border-color: #1890ff;
}

/* ============================================================================
   分组框样式
   ============================================================================ */

QGroupBox {
    border: 1px solid #e8e8e8;
    border-radius: 8px;
    margin-top: 12px;
    padding: 16px;
    background-color: #ffffff;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 12px;
    top: -6px;
    padding: 0 8px;
    background-color: #ffffff;
    color: #262626;
    font-weight: 600;
}

/* ============================================================================
   标签页样式
   ============================================================================ */

QTabWidget::pane {
    border: 1px solid #e8e8e8;
    border-radius: 8px;
    background-color: #ffffff;
    top: -1px;
}

QTabBar::tab {
    background-color: transparent;
    color: #595959;
    padding: 10px 20px;
    border-bottom: 2px solid transparent;
    margin-right: 4px;
}

QTabBar::tab:hover {
    color: #262626;
}

QTabBar::tab:selected {
    color: #1890ff;
    border-bottom: 2px solid #1890ff;
    font-weight: 600;
}

/* ============================================================================
   对话框样式
   ============================================================================ */

QDialog {
    background-color: #ffffff;
    border-radius: 12px;
}

/* ============================================================================
   菜单样式
   ============================================================================ */

QMenuBar {
    background-color: #ffffff;
    border-bottom: 1px solid #f0f0f0;
    padding: 4px;
}

QMenuBar::item {
    padding: 8px 16px;
    border-radius: 6px;
}

QMenuBar::item:selected {
    background-color: #f5f5f5;
}

QMenu {
    background-color: #ffffff;
    border: 1px solid #e8e8e8;
    border-radius: 8px;
    padding: 4px;
}

QMenu::item {
    padding: 8px 24px 8px 16px;
    border-radius: 4px;
    color: #262626;
}

QMenu::item:selected {
    background-color: #f5f5f5;
}

QMenu::separator {
    height: 1px;
    background-color: #f0f0f0;
    margin: 4px 8px;
}

/* ============================================================================
   工具提示
   ============================================================================ */

QToolTip {
    background-color: rgba(0, 0, 0, 0.85);
    color: #ffffff;
    border: none;
    border-radius: 6px;
    padding: 8px 12px;
    font-size: 12px;
}

/* ============================================================================
   侧边栏 - 浅色
   ============================================================================ */

#SideMenu {
    background-color: #ffffff;
    border-right: 1px solid #e8e8e8;
}

#LogoContainer {
    background-color: #fafafa;
    border-bottom: 1px solid #f0f0f0;
}

#LogoLabel {
    font-size: 16px;
    font-weight: 600;
    color: #262626;
}

#MenuSeparator {
    background-color: #f0f0f0;
}

#MenuList {
    background-color: transparent;
    border: none;
}

#MenuList::item {
    color: #595959;
    font-size: 14px;
    height: 44px;
    padding: 0 16px;
    border-radius: 8px;
    margin: 2px 0;
}

#MenuList::item:hover {
    background-color: #f5f5f5;
    color: #262626;
}

#MenuList::item:selected {
    background-color: #e6f7ff;
    color: #1890ff;
}

#MenuFooter {
    background-color: #fafafa;
    border-top: 1px solid #f0f0f0;
}

#VersionLabel {
    font-size: 12px;
    color: #bfbfbf;
}

/* ============================================================================
   标题栏 - 浅色
   ============================================================================ */

#TitleBar {
    background-color: #ffffff;
    border-bottom: 1px solid #f0f0f0;
}

#TitleBarSpacer {
    background-color: #ffffff;
    border-right: 1px solid #f0f0f0;
}

#Breadcrumb {
    color: #595959;
    font-size: 14px;
}

#Breadcrumb {
    font-size: 15px;
    color: #8c8c8c;
}

#ThemeButton, #UserButton, #MinimizeButton {
    background-color: transparent;
    border: none;
    border-radius: 6px;
}

#ThemeButton:hover, #UserButton:hover, #MinimizeButton:hover {
    background-color: #f5f5f5;
}

#CloseButton {
    background-color: transparent;
    border: none;
    border-radius: 6px;
}

#CloseButton:hover {
    background-color: #ff4d4f;
}

/* ============================================================================
   实时画面页面组件 - 浅色
   ============================================================================ */

#RecognitionPage {
    background-color: #f5f5f7;
}

#VideoContainer {
    background-color: transparent;
}

/* 用户信息面板 - 浅色主题 */
#UserInfoPanel {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 rgba(240, 245, 255, 0.98), stop:0.5 rgba(248, 250, 255, 0.98), stop:1 rgba(240, 245, 255, 0.98));
    border-bottom-left-radius: 12px;
    border-bottom-right-radius: 12px;
    border-top: 1px solid rgba(24, 144, 255, 0.1);
}

/* 头像容器 */
#AvatarContainer {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
        stop:0 #1890ff, stop:1 #722ed1);
    border-radius: 34px;
    border: 3px solid rgba(255, 255, 255, 0.8);
}

#AvatarIcon {
    font-size: 32px;
    color: #ffffff;
    background: transparent;
}

/* 用户名 */
#UserNameLabel {
    color: #262626;
    font-size: 22px;
    font-weight: 700;
    background: transparent;
    letter-spacing: 0.5px;
}

/* 签到成功状态标签 */
#AttendanceStatusLabel {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, 
        stop:0 #52c41a, stop:1 #73d13d);
    color: white;
    padding: 6px 16px;
    border-radius: 16px;
    font-size: 13px;
    font-weight: 600;
}

/* 元信息标签（工号、部门） */
#UserMetaLabel {
    color: #8c8c8c;
    font-size: 13px;
    background: transparent;
}

#MetaSeparator {
    color: #d9d9d9;
    font-size: 13px;
    background: transparent;
}

/* 右侧指标容器 */
#MetricsContainer {
    background: transparent;
}

/* 指标卡片 */
#MetricCard {
    background: rgba(255, 255, 255, 0.8);
    border-radius: 12px;
    border: 1px solid rgba(24, 144, 255, 0.15);
}

#MetricCard:hover {
    background: rgba(255, 255, 255, 0.95);
    border-color: rgba(24, 144, 255, 0.25);
}

/* 指标数值 */
#MetricValue {
    color: #1890ff;
    font-size: 18px;
    font-weight: 700;
    background: transparent;
}

/* 指标标题 */
#MetricTitle {
    color: #8c8c8c;
    font-size: 11px;
    font-weight: 500;
    background: transparent;
}

/* 每日一句容器 */
#SentenceContainer {
    background: transparent;
}

#SentenceEnLabel {
    color: rgba(24, 144, 255, 0.95);
    font-size: 16px;
    font-style: italic;
    font-family: "Georgia", "Times New Roman", serif;
    background: transparent;
}

#SentenceCnLabel {
    color: #8c8c8c;
    font-size: 14px;
    background: transparent;
}

/* 兼容旧标签 */
#UserInfoLabel {
    color: #595959;
    font-size: 14px;
    background: transparent;
}

#UserDetailLabel {
    color: #8c8c8c;
    font-size: 13px;
    background: transparent;
}

#StatusContainer {
    background: transparent;
}

#StatusTitle {
    color: #8c8c8c;
    font-size: 12px;
    background: transparent;
}

#StatusValue {
    color: #52c41a;
    font-size: 16px;
    font-weight: 600;
    background: transparent;
}

#FpsValue {
    color: #1890ff;
    font-size: 16px;
    font-weight: 600;
    background: transparent;
}

#GhostButton {
    background-color: transparent;
    border: 1px solid #1890ff;
    color: #1890ff;
    border-radius: 8px;
    padding: 0 16px;
    font-weight: 500;
}

#GhostButton:hover {
    background-color: #e6f7ff;
}

/* ========================================
   信息栏（天气 + 考勤统计）- 增强版
   ======================================== */

#InfoBar {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 rgba(230, 247, 255, 0.95), stop:0.5 rgba(240, 245, 255, 0.95), stop:1 rgba(230, 247, 255, 0.95));
    border-bottom: 1px solid rgba(24, 144, 255, 0.15);
}

#InfoBarCard {
    background: rgba(255, 255, 255, 0.7);
    border-radius: 12px;
    border: 1px solid rgba(24, 144, 255, 0.1);
}

#InfoBarCardTitle {
    color: #8c8c8c;
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.5px;
    background: transparent;
}

/* 天气卡片 - 特殊样式 */
#WeatherCard {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
        stop:0 rgba(24, 144, 255, 0.15), stop:1 rgba(114, 46, 209, 0.1));
    border-radius: 16px;
    border: 1px solid rgba(24, 144, 255, 0.2);
    min-width: 300px;
}

#WeatherTempBig {
    color: #1890ff;
    font-size: 42px;
    font-weight: 700;
    font-family: "DIN Alternate", "SF Pro Display", "Segoe UI", sans-serif;
    background: transparent;
    min-width: 80px;
}

#WeatherCityLabel {
    color: #262626;
    font-size: 16px;
    font-weight: 600;
    background: transparent;
}

#WeatherDescLabel {
    color: #8c8c8c;
    font-size: 14px;
    font-weight: 500;
    background: transparent;
}

#InfoBarSeparator {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 transparent, stop:0.2 #d9d9d9, stop:0.8 #d9d9d9, stop:1 transparent);
}

#StatsItemLabel {
    color: #8c8c8c;
    font-size: 13px;
    font-weight: 500;
    background: transparent;
}

#StatsCheckinValue {
    color: #52c41a;
    font-size: 24px;
    font-weight: 700;
    font-family: "DIN Alternate", "SF Pro Display", "Segoe UI", sans-serif;
    background: transparent;
}

#StatsCheckoutValue {
    color: #1890ff;
    font-size: 24px;
    font-weight: 700;
    font-family: "DIN Alternate", "SF Pro Display", "Segoe UI", sans-serif;
    background: transparent;
}

#StatsAbnormalValue {
    color: #8c8c8c;
    font-size: 24px;
    font-weight: 700;
    font-family: "DIN Alternate", "SF Pro Display", "Segoe UI", sans-serif;
    background: transparent;
}

#StatsAbnormalValue[hasAlert="true"] {
    color: #ff4d4f;
}

#ModeCard {
    background: rgba(255, 255, 255, 0.8);
    border-radius: 16px;
    border: 2px solid rgba(82, 196, 26, 0.3);
    min-width: 100px;
}

#ModeTitle {
    color: #8c8c8c;
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.5px;
    background: transparent;
}

#CheckModeLabel {
    font-size: 22px;
    font-weight: 700;
    color: #52c41a;
    background: transparent;
}

#CheckModeLabel[mode="checkout"] {
    color: #fa8c16;
}

/* ========================================
   综合状态栏（时钟 + 检测状态）- 增强版
   ======================================== */

#DetectionStatusBar {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 rgba(240, 245, 255, 0.95), stop:0.5 rgba(255, 255, 255, 0.98), stop:1 rgba(240, 245, 255, 0.95));
    border-top: 1px solid rgba(24, 144, 255, 0.1);
    border-bottom: 1px solid rgba(24, 144, 255, 0.15);
}

#ClockCard {
    background: rgba(255, 255, 255, 0.7);
    border-radius: 12px;
    border: 1px solid rgba(24, 144, 255, 0.1);
    min-width: 200px;
}

#ClockLabel {
    color: #1890ff;
    font-size: 32px;
    font-weight: 700;
    font-family: "JetBrains Mono", "SF Mono", "Fira Code", "Consolas", monospace;
    letter-spacing: 2px;
    background: transparent;
}

#DateLabel {
    color: #8c8c8c;
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 0.5px;
    background: transparent;
}

#StatusBarSeparator {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 transparent, stop:0.2 #d9d9d9, stop:0.8 #d9d9d9, stop:1 transparent);
}

#FaceDetectionCard {
    background: rgba(255, 255, 255, 0.7);
    border-radius: 12px;
    border: 1px solid rgba(24, 144, 255, 0.1);
}

#FaceCardTitle {
    color: #8c8c8c;
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.5px;
    background: transparent;
}

#FaceCountValue {
    font-size: 28px;
    font-weight: 700;
    font-family: "DIN Alternate", "SF Pro Display", "Segoe UI", sans-serif;
    background: transparent;
}

#FaceCountValue[status="active"] {
    color: #52c41a;
}

#FaceCountValue[status="inactive"] {
    color: #bfbfbf;
}

#ProgressCard {
    background: rgba(255, 255, 255, 0.7);
    border-radius: 12px;
    border: 1px solid rgba(24, 144, 255, 0.1);
    min-width: 200px;
}

#DetectionStatusLabel {
    color: #595959;
    font-size: 14px;
    font-weight: 600;
    background: transparent;
}

#DetectionProgressBar {
    background-color: rgba(0, 0, 0, 0.06);
    border: none;
    border-radius: 4px;
}

#DetectionProgressBar::chunk {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #1890ff, stop:0.5 #36cfc9, stop:1 #52c41a);
    border-radius: 4px;
}
