/* 全局字体与背景 */
QWidget {
    font-family: "Tencent Sans","Source Han Sans","Microsoft YaHei",sans-serif;
    color: #1f1f1f;
    background-color: #f5f6fb;
}

QLabel#Caption {
    font-size: 12px;
    color: #8c8c8c;
    text-transform: uppercase;
    letter-spacing: 0.08em;
}

/* CardWidget */
CardWidget {
    background: #ffffff;
    border-radius: 16px;
    border: 1px solid #eef0f6;
    padding: 24px;
    qproperty-alignment: AlignTop;
    box-shadow: 0px 10px 30px rgba(15,23,42,0.08);
}

CardWidget[cardVariant="ghost"] {
    background: transparent;
    border: 1px dashed #d9d9d9;
    box-shadow: none;
}

CardWidget[cardVariant="dark"] {
    background: #0f172a;
    color: #ffffff;
    border: none;
    box-shadow: 0px 8px 20px rgba(0,0,0,0.3);
}

/* 按钮 */
QPushButton {
    min-height: 36px;
    padding: 0 18px;
    border-radius: 8px;
    border: 1px solid transparent;
    background: #f0f5ff;
    color: #1f1f1f;
}

QPushButton:hover {
    background: #d6e4ff;
}

QPushButton:pressed {
    background: #a4c2ff;
}

QPushButton:disabled {
    background: #f0f0f0;
    color: #bfbfbf;
}

QPushButton[primary="true"] {
    background: #1677ff;
    color: #ffffff;
}

QPushButton[primary="true"]:hover {
    background: #4096ff;
}

QPushButton[primary="true"]:pressed {
    background: #0958d9;
}

/* IconButton */
IconButton {
    border-radius: 8px;
    padding: 8px;
    background: transparent;
}

IconButton:hover {
    background: rgba(22,119,255,0.12);
}

IconButton[active="true"] {
    background: rgba(22,119,255,0.18);
}

/* SearchInput */
SearchInput QLineEdit {
    border-radius: 12px;
    border: 1px solid #d9d9d9;
    background: #ffffff;
    padding: 8px 12px 8px 36px;
}

SearchInput QLineEdit:focus {
    border: 1px solid #1677ff;
    box-shadow: 0 0 0 3px rgba(22,119,255,0.12);
}

/* 侧边菜单 */
#SideMenu {
    background: #0f172a;
    color: #ffffff;
}

#SideMenu QListView {
    border: none;
    background: transparent;
}

#SideMenu QListView::item {
    padding: 10px 18px;
    border-radius: 12px;
}

#SideMenu QListView::item:selected {
    background: rgba(22,119,255,0.18);
}

/* 表格 */
ModernTableView {
    background: #ffffff;
    border: 1px solid #eef0f6;
    border-radius: 16px;
    alternate-background-color: #fafafa;
}

QHeaderView::section {
    background: #fafafa;
    border: none;
    height: 44px;
    padding: 0 16px;
    font-weight: 600;
}

ModernTableView::item {
    padding: 12px;
}

ModernTableView::item:hover {
    background: rgba(22,119,255,0.08);
}

ModernTableView::item:selected {
    background: rgba(22,119,255,0.16);
}

/* Tag */
StatusTag {
    border-radius: 12px;
    padding: 2px 10px;
    border: 1px solid transparent;
    background: #f5f5f5;
}

StatusTag[type="success"] {
    background: #f6ffed;
    color: #52c41a;
    border-color: #b7eb8f;
}

StatusTag[type="warning"] {
    background: #fffbe6;
    color: #faad14;
    border-color: #ffe58f;
}

StatusTag[type="error"] {
    background: #fff2f0;
    color: #ff4d4f;
    border-color: #ffccc7;
}

/* Toast */
ToastItem {
    background: #ffffff;
    border-radius: 12px;
    padding: 16px 20px;
    border: 1px solid #eef0f6;
    border-left: 4px solid #1677ff;
}

/* 滚动条 */
QScrollBar:vertical {
    background: transparent;
    width: 6px;
    margin: 4px;
}

QScrollBar::handle:vertical {
    background: rgba(0,0,0,0.25);
    border-radius: 3px;
}

QScrollBar::handle:vertical:hover {
    background: rgba(0,0,0,0.35);
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0;
}

